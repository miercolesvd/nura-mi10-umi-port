# touch driver selection (build.sh, TOUCH=stfts)
# CONFIG_TOUCHSCREEN_ST_FTS_V521 is not set
# CONFIG_TOUCHSCREEN_FTS_UMI is not set
CONFIG_TOUCHSCREEN_ST_FTS=y
CONFIG_FTS_FOD_AREA_REPORT=y
# Nura: cmdline comes from the boot image (deviceinfo_kernel_cmdline)
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE=""
# no Rust toolchain in the Nura build chroot; plain-text DRM panic screen
# CONFIG_RUST is not set
# CONFIG_DRM_PANIC_SCREEN_QR_CODE is not set
CONFIG_DRM_PANIC_SCREEN="kmsg"
CONFIG_LOCALVERSION="-xiaomi-umi"
# first images: no 40 W charge pump driver until charging is verified on device
# CONFIG_CHARGER_BQ25970 is not set
# Nura (pmaports) default rules: zstd-compressed modules
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y
CONFIG_MODULE_DECOMPRESS=y

# Flashless SDX55M modem: Sahara/EFS channels for the userspace image server
CONFIG_MHI_SAHARA_CDEV=m
