# Reference: <https://nura.eco/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Xiaomi Mi 10"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-umi"
deviceinfo_year="2020"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2340"
deviceinfo_drm="true"

# Kernel options
# The *_ignore_unused switches and the SMMU bypass are what the mainline
# bring-up boots with: rails and clocks the bootloader left on have no
# consumer in the device tree yet.
deviceinfo_dtb="qcom/sm8250-xiaomi-umi"
deviceinfo_kernel_cmdline="console=tty0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused arm-smmu.disable_bypass=0"

# Bootloader related
# Android boot image header v2: gzip kernel, DTB in the header's dtb section.
# The stock dtbo partition is left untouched; the bootloader applies its
# overlays to our DTB, which is why the DTB is built with symbols (-@).
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="2"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_offset_dtb="0x01f00000"
deviceinfo_flash_sparse="true"
# Checked on the phone: non-A/B, one PARTLABEL=boot (sde50, 128 MiB), and the
# boot.img built on the device boots when written there.
deviceinfo_flash_kernel_on_update="true"

# Required for devices using UFS as storage (instead of e.g. eMMC)
deviceinfo_rootfs_image_sector_size="4096"
