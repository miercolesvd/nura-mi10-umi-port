# Reference: <https://nura.eco/devicepkg>
pkgname=device-xiaomi-umi
pkgdesc="Xiaomi Mi 10"
pkgver=3
pkgrel=0
url="https://nura.eco"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-xiaomi-umi-adreno
	firmware-xiaomi-umi-initramfs
	linux-firmware-ath11k
	linux-firmware-qca
	linux-xiaomi-umi
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
source="
	90-device-xiaomi-umi.rules
	deviceinfo
	initfs-hook.sh
	modules-load.conf
	ucm-HiFi.conf
	ucm-card.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ALSA UCM: the card is driver "sm8250", long name "Xiaomi Mi 10"
	install -Dm644 "$srcdir"/ucm-card.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi Mi 10.conf"
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Xiaomi/umi/HiFi.conf
}

