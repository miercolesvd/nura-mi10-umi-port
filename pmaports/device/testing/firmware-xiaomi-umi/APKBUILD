pkgname=firmware-xiaomi-umi
pkgver=20261115
pkgrel=1
pkgdesc="Firmware for Xiaomi Mi 10"
subpackages="
	$pkgname-adreno
	$pkgname-initramfs
"
url="https://github.com/colorgarden/umi-mainline"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"

# Files taken from firmware/qcom/ of colorgarden/umi-mainline @ e38cb76b41c9.
# The zap shader is signed for this device; a650_sqe.fw is the linux-firmware
# one. Kept as local sources until a firmware repository for umi exists.
source="
	30-bt-firmware.files
	30-gpu-firmware.files
	a650_gmu.bin
	a650_sqe.fw
	a650_zap.b00
	a650_zap.b01
	a650_zap.b02
	a650_zap.mbn
	a650_zap.mdt
"

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

# The device tree asks for qcom/a650_zap.mdt, so these go to the generic path.
adreno() {
	pkgdesc="Xiaomi Mi 10 Adreno 650 firmware"
	replaces="linux-firmware-qcom firmware-qcom-adreno-a650"

	install -Dm644 \
		"$srcdir"/a650_gmu.bin \
		"$srcdir"/a650_sqe.fw \
		"$srcdir"/a650_zap.b00 \
		"$srcdir"/a650_zap.b01 \
		"$srcdir"/a650_zap.b02 \
		"$srcdir"/a650_zap.mbn \
		"$srcdir"/a650_zap.mdt \
		-t "$subpkgdir/usr/lib/firmware/qcom/"
}

# msm/adreno and the QCA6390 Bluetooth driver (hci_uart_qca) are built into
# the kernel and probe before the rootfs is mounted, so their firmware has to
# be in the initramfs. The Bluetooth files come from linux-firmware-qca.
initramfs() {
	pkgdesc="Xiaomi Mi 10 firmware to be included in the initramfs"
	depends="linux-firmware-qca"

	install -Dm644 "$srcdir/30-gpu-firmware.files" \
		"$subpkgdir/usr/share/mkinitfs/files/30-gpu-firmware.files"
	install -Dm644 "$srcdir/30-bt-firmware.files" \
		"$subpkgdir/usr/share/mkinitfs/files/30-bt-firmware.files"
}

