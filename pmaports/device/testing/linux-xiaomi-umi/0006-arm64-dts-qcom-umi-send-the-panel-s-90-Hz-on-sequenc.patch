From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pmaports <pmaports@localhost>
Date: Tue, 17 Nov 2026 08:32:22 +0000
Subject: [PATCH] arm64: dts: qcom: umi: send the panel's 90 Hz on-sequence

The on-sequence was the stock timing@0 (60 Hz) one, which sets DCS 0x2F to 1 and 0x26 to 1, while the mode timings are the 90 Hz ones. The panel then raised TE at 60 Hz and the display ran at 60 fps. Use the stock timing@1 on-command (B4 table, 0x2F 0x04, 0x26 0x02).
---
 arch/arm64/boot/dts/qcom/xiaomi-umi-panels.dtsi | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/xiaomi-umi-panels.dtsi b/arch/arm64/boot/dts/qcom/xiaomi-umi-panels.dtsi
index a9232b245..c35f03cd0 100644
--- a/arch/arm64/boot/dts/qcom/xiaomi-umi-panels.dtsi
+++ b/arch/arm64/boot/dts/qcom/xiaomi-umi-panels.dtsi
@@ -57,6 +57,7 @@ umi-panel@0 {
 		xiaomi,v-front-porch = <0x04>;
 		xiaomi,v-pulse-width = <0x04>;
 		xiaomi,clockrate = <0x28a67e80>;
+		/* stock timing@1 (90 Hz) on-command: B4 table, 2F 04, 26 02 */
 		xiaomi,on-seq = /bits/ 8 <0x39 0x01 0x00 0x00 0x00 0x00 0x06 0xf0 0x55 0xaa 0x52 0x08 0x07 0x15 0x01 0x00
 			0x00 0x00 0x00 0x02 0xc0 0x10 0x39 0x01 0x00 0x00 0x00 0x00 0x06 0xf0 0x55 0xaa
 			0x52 0x08 0x03 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0xd4 0x00 0x39 0x01 0x00 0x00
@@ -92,10 +93,10 @@ umi-panel@0 {
 			0x00 0x00 0x05 0x51 0x00 0x00 0x00 0x00 0x39 0x01 0x00 0x00 0x00 0x00 0x05 0x2a
 			0x00 0x00 0x04 0x37 0x39 0x01 0x00 0x00 0x00 0x00 0x05 0x2b 0x00 0x00 0x09 0x23
 			0x39 0x01 0x00 0x00 0x00 0x00 0x06 0xf0 0x55 0xaa 0x52 0x08 0x00 0x39 0x01 0x00
-			0x00 0x00 0x00 0x1e 0xb4 0xcb 0xbb 0xbb 0xaa 0x99 0x77 0x66 0x00 0x00 0x00 0xb4
-			0xd0 0xd0 0xd0 0xd0 0xd0 0x86 0x86 0x3c 0x3c 0xf2 0xf2 0xa8 0xa8 0x36 0x36 0x36
-			0x36 0x0a 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0x2f 0x01 0x15 0x01 0x00 0x00 0x00
-			0x00 0x02 0x26 0x01 0x05 0x01 0x00 0x00 0x64 0x00 0x02 0x11 0x00 0x05 0x01 0x00
+			0x00 0x00 0x00 0x1e 0xb4 0x98 0x88 0x88 0x77 0x66 0x55 0x44 0x00 0x00 0x00 0x60
+			0xb8 0xb8 0xb8 0xb8 0xb8 0xc8 0xc8 0xd8 0xd8 0xe8 0xe8 0xf8 0xf8 0x48 0x48 0x48
+			0x48 0x0a 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0x2f 0x04 0x15 0x01 0x00 0x00 0x00
+			0x00 0x02 0x26 0x02 0x05 0x01 0x00 0x00 0x64 0x00 0x02 0x11 0x00 0x05 0x01 0x00
 			0x00 0x00 0x00 0x02 0x29 0x00 0x39 0x01 0x00 0x00 0x00 0x00 0x06 0xf0 0x55 0xaa
 			0x52 0x08 0x00 0x15 0x01 0x00 0x00 0x00 0x00 0x02 0xb5 0x84>;
 		xiaomi,off-seq = /bits/ 8 <0x05 0x01 0x00 0x00 0x00 0x00 0x02 0x28 0x00 0x05 0x01 0x00 0x00 0x78 0x00 0x02
