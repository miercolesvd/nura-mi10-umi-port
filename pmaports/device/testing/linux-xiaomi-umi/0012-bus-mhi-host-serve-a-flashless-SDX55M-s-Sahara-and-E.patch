 drivers/bus/mhi/host/Makefile          |   2 +
 drivers/bus/mhi/host/mhi_sahara_cdev.c | 442 +++++++++++++++++++++++++
 drivers/bus/mhi/host/pci_generic.c     |  52 ++-
 4 files changed, 504 insertions(+), 1 deletion(-)
 create mode 100644 drivers/bus/mhi/host/mhi_sahara_cdev.c

