+};
+
+static const struct mhi_controller_config modem_qcom_sdx55_mhiv_config = {
+	.max_channels = 128,
+	.timeout_ms = 8000,
+	.num_channels = ARRAY_SIZE(modem_qcom_sdx55_mhi_channels),
