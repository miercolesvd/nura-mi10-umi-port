+/*
+ * The flashless SDX55M in the Xiaomi Mi 10 reports subsystem 17cb:010c, the
+ * same as the Foxconn T99W175, which boots from its own flash. Nothing on
+ * the bus tells them apart, so the board's userspace says which one it is.
+ */
+static bool sdx55_flashless;
+module_param(sdx55_flashless, bool, 0444);
+MODULE_PARM_DESC(sdx55_flashless,
+		 "17cb:0306 with subsystem 17cb:010c is a flashless SDX55M (Xiaomi Mi 10), not a Foxconn T99W175");
+
