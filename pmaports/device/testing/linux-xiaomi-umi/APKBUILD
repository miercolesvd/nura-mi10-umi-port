# Reference: <https://nura.eco/vendorkernel>
# Kernel config based on: arch/arm64/configs/defconfig
#   + config fragment of github.com/colorgarden/umi-mainline
#   + Nura (pmaports) kconfigcheck rules (see tools/ in the port repo)
_flavor="xiaomi-umi"
pkgname=linux-$_flavor
pkgver=6.12.94
pkgrel=2
pkgdesc="Close-to-mainline LTS kernel for Xiaomi Mi 10"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
"
makedepends="
	bash
	bison
	clang
	diffutils
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	sed
	zstd
"

# Source
_config="config-$_flavor.$arch"
source="
	linux-$pkgver.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz
	$_config
	0001-dmaengine-qcom-gpi-add-sm8250-EE-offset-variants.patch
	0002-drm-panel-add-Xiaomi-Mi-10-umi-DSC-command-mode-AMOL.patch
	0003-Input-touchscreen-add-vendor-derived-ST-FTS-driver-f.patch
	0004-power-supply-add-Qualcomm-PM8150B-fuel-gauge-SMB5-ch.patch
	0005-arm64-dts-qcom-add-Xiaomi-Mi-10-umi.patch
	0006-arm64-dts-qcom-umi-send-the-panel-s-90-Hz-on-sequenc.patch
	0007-ASoC-cs35l41-don-t-fail-power-up-when-PUP-PDN-status.patch
	0008-ASoC-qcom-sm8250-set-up-both-CS35L41-amps-on-Xiaomi-.patch
	0009-arm64-dts-qcom-umi-load-ADSP-firmware-through-msm-fi.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config

	# The config was generated with a different clang than the one in the
	# build chroot. Resolve compiler-dependent symbols non-interactively,
	# otherwise the build stops at a syncconfig prompt.
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	make modules_install zinstall dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

