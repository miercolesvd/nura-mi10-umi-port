From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pmaports <pmaports@localhost>
Date: Tue, 17 Nov 2026 11:37:43 +0000
Subject: [PATCH 13/13] bus: mhi: host: pci_generic: max_msi_vectors parameter

Bring-up aid: limit the MSI vectors a device gets, down to one shared by
BHI and all event rings, to tell an interrupt delivery problem from a
device that posts no events.
---
 drivers/bus/mhi/host/pci_generic.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/drivers/bus/mhi/host/pci_generic.c b/drivers/bus/mhi/host/pci_generic.c
index 787f74914..5c26cab35 100644
--- a/drivers/bus/mhi/host/pci_generic.c
+++ b/drivers/bus/mhi/host/pci_generic.c
@@ -1038,6 +1038,11 @@ static int mhi_pci_claim(struct mhi_controller *mhi_cntrl,
 	return 0;
 }
 
+/* Bring-up aid: cap the MSI vectors (1 = one vector shared by BHI and all rings) */
+static unsigned int max_msi_vectors;
+module_param(max_msi_vectors, uint, 0444);
+MODULE_PARM_DESC(max_msi_vectors, "Use at most this many MSI vectors (0: one per event ring)");
+
 static int mhi_pci_get_irqs(struct mhi_controller *mhi_cntrl,
 			    const struct mhi_controller_config *mhi_cntrl_config)
 {
@@ -1051,7 +1056,11 @@ static int mhi_pci_get_irqs(struct mhi_controller *mhi_cntrl,
 	 */
 	mhi_cntrl->nr_irqs = 1 + mhi_cntrl_config->num_events;
 
-	nr_vectors = pci_alloc_irq_vectors(pdev, 1, mhi_cntrl->nr_irqs, PCI_IRQ_MSI);
+	nr_vectors = pci_alloc_irq_vectors(pdev, 1,
+					   max_msi_vectors ?
+					   min(mhi_cntrl->nr_irqs, max_msi_vectors) :
+					   mhi_cntrl->nr_irqs,
+					   PCI_IRQ_MSI);
 	if (nr_vectors < 0) {
 		dev_err(&pdev->dev, "Error allocating MSI vectors %d\n",
 			nr_vectors);
