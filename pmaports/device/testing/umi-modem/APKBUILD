pkgname=umi-modem
pkgver=0.1
pkgrel=4
pkgdesc="Xiaomi Mi 10: boot the SDX55M modem (Sahara image server, EFS syncs kept in RAM)"
url="https://github.com/miercolesvd/mi10-port"
arch="aarch64"
license="GPL-2.0-only AND BSD-3-Clause"
depends="iproute2"
makedepends="linux-headers qrtr-dev"
source="
	mi10-mdm.c
	mi10-qmi.c
	umi-modem-start
	umi-modem-data
	umi-modem-data-up
	umi-modem.service
	umi-modem.conf
	umi-tqftpserv.service
	tqftpserv-version.diff
	tqftpserv-tqftpserv.c
	tqftpserv-translate.c
	tqftpserv-translate.h
	tqftpserv-list.h
	tqftpserv-xz-decompress.h
	tqftpserv-zstd-decompress.h
	tqftpserv-LICENSE
	"
builddir="$srcdir"
options="!check" # tested against a simulated modem in the mi-10-hotspot repo

prepare() {
	# linux-msm/tqftpserv at eb4b9a04 (BSD-3-Clause, tqftpserv-LICENSE) with
	# mi-10-hotspot's -v option: this modem finds no TFTP server published
	# as version 1 only. Built without xz/zstd: the modem's files are plain.
	mkdir -p "$srcdir"/tqftpserv
	for f in tqftpserv.c translate.c translate.h list.h \
		 xz-decompress.h zstd-decompress.h; do
		cp "$srcdir"/tqftpserv-$f "$srcdir"/tqftpserv/$f
	done
	cd "$srcdir"/tqftpserv
	patch -p1 < "$srcdir"/tqftpserv-version.diff
}

build() {
	${CC:-gcc} $CFLAGS -Wall -Wextra -pthread -o mi10-mdm mi10-mdm.c $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -Wextra -o mi10-qmi mi10-qmi.c $LDFLAGS
	${CC:-gcc} $CFLAGS -Wall -o tqftpserv/tqftpserv \
		tqftpserv/tqftpserv.c tqftpserv/translate.c $LDFLAGS -lqrtr
}

package() {
	install -Dm755 mi10-mdm "$pkgdir"/usr/sbin/mi10-mdm
	install -Dm755 mi10-qmi "$pkgdir"/usr/sbin/mi10-qmi
	install -Dm755 umi-modem-data "$pkgdir"/usr/sbin/umi-modem-data
	install -Dm755 umi-modem-data-up "$pkgdir"/usr/libexec/umi-modem/umi-modem-data-up
	install -Dm755 umi-modem-start "$pkgdir"/usr/libexec/umi-modem/umi-modem-start
	install -Dm644 umi-modem.service "$pkgdir"/usr/lib/systemd/system/umi-modem.service
	install -Dm644 umi-modem.conf "$pkgdir"/usr/lib/modprobe.d/umi-modem.conf
	install -Dm755 "$srcdir"/tqftpserv/tqftpserv \
		"$pkgdir"/usr/libexec/umi-modem/tqftpserv
	install -Dm644 umi-tqftpserv.service \
		"$pkgdir"/usr/lib/systemd/system/umi-tqftpserv.service
	install -Dm644 tqftpserv-LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/tqftpserv-LICENSE
}
sha512sums="

"
